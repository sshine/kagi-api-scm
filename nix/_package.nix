# The build definition, shared by this flake's package and by the overlay.
#
# Taking `pkgs` arguments (rather than closing over this flake's own nixpkgs) is what lets
# the overlay build against the consumer's nixpkgs.
#
# One derivation per module, because Nix reuses a derivation or rebuilds it whole: a single
# derivation compiling every module means every edit recompiles all of them. Here each
# module names its imports (nix/deps.json, generated by `just gen-deps`), so an edit to
# `src/kagi/error.scm` recompiles that module and the ones above it, not everything.
{
  lib,
  stdenv,
  guile_3_0,
  buildEnv,
  # The one list of Guile libraries, shared with the dev shell and the lint hook.
  guileLibs,
  # name -> { file, deps, external }, from nix/deps.json.
  graph,
}:
let
  names = builtins.attrNames graph;
  depsOf = name: graph.${name}.deps;

  # Every module reachable from NAME, excluding NAME itself. Guile executes a dependency's
  # top level when it loads it, so a module needs its whole transitive closure on the load
  # path, not just its direct imports.
  closureOf =
    name:
    let
      step =
        acc:
        builtins.foldl' (
          a: d:
          a
          // {
            ${d} = null;
          }
          // builtins.listToAttrs (
            map (x: {
              name = x;
              value = null;
            }) (depsOf d)
          )
        ) acc (builtins.attrNames acc);
      close = acc: if step acc == acc then acc else close (step acc);
    in
    builtins.attrNames (
      close (
        builtins.listToAttrs (
          map (d: {
            name = d;
            value = null;
          }) (depsOf name)
        )
      )
    );

  compileModule =
    name:
    let
      info = graph.${name};
      rel = lib.removePrefix "src/" info.file;
      object = "${lib.removeSuffix ".scm" rel}.go";
      closure = map (d: modules.${d}) (closureOf name);
    in
    stdenv.mkDerivation {
      pname = "kagi-api-scm-module-${lib.replaceStrings [ "/" " " ] [ "-" "-" ] rel}";
      version = "0.1.0";

      # Only this file. The per-module fileset is what makes the split granular: sharing
      # one `src` between the derivations would invalidate all of them on any edit.
      src = lib.fileset.toSource {
        root = ../.;
        fileset = ../. + "/${info.file}";
      };

      nativeBuildInputs = [ guile_3_0 ];
      buildInputs = [ guile_3_0 ] ++ guileLibs ++ map (d: modules.${d}) info.deps;
      GUILE_LOAD_PATH = lib.concatMapStringsSep ":" (d: "${d}/share/guile/site/3.0") closure;
      GUILE_LOAD_COMPILED_PATH = lib.concatMapStringsSep ":" (
        d: "${d}/lib/guile/3.0/site-ccache"
      ) closure;

      dontConfigure = true;

      buildPhase = ''
        runHook preBuild
        mkdir -p "$out/lib/guile/3.0/site-ccache/$(dirname ${rel})"
        guild compile -L "$src" -O1 -Wunbound-variable -Warity-mismatch \
          -o "$out/lib/guile/3.0/site-ccache/${object}" "$src/${info.file}"
        runHook postBuild
      '';

      installPhase = ''
        runHook preInstall
        install -Dm644 "$src/${info.file}" "$out/share/guile/site/3.0/${rel}"
        runHook postInstall
      '';

      meta = {
        description = "One module of the Kagi Scheme client";
        license = lib.licenses.mit;
        platforms = guile_3_0.meta.platforms;
      };
    };

  modules = lib.genAttrs names compileModule;

  moduleEnv = buildEnv {
    name = "kagi-api-scm-modules";
    paths = lib.attrValues modules;
  };
in
stdenv.mkDerivation {
  pname = "kagi-api-scm";
  version = "0.1.0";

  dontUnpack = true;
  buildInputs = [ moduleEnv ];
  dontConfigure = true;
  dontBuild = true;

  installPhase = ''
    runHook preInstall
    mkdir -p $out
    cp -r ${moduleEnv}/. $out/
    runHook postInstall
  '';

  meta = {
    description = "A Guile Scheme client for the Kagi v1 Search API";
    license = lib.licenses.mit;
    platforms = guile_3_0.meta.platforms;
  };
}
